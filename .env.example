# Required for live scoring (/api/analyze). Create a key at
# https://platform.claude.com — it stays server-side; the browser never sees it.
ANTHROPIC_API_KEY=

# Optional. Model for the public analyzer. Defaults to claude-opus-4-8 (most
# capable). Use claude-haiku-4-5 for a much cheaper public deployment.
# ANALYZER_MODEL=claude-opus-4-8

# Optional. Scoring requests allowed per IP per hour (default 10; best-effort
# per warm serverless instance).
# ANALYZER_RATE_LIMIT=10
